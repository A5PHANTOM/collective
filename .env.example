# Used only when creating a new database without an existing legacy data file.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=1234

# Groq calls run on the FastAPI server. Do not use a VITE_ prefix for secrets.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Set true when serving over HTTPS.
COOKIE_SECURE=false

# Optional overrides:
# DATABASE_PATH=/absolute/path/to/collective.sqlite3
# DEV_ORIGIN=http://localhost:5173

# Web Push: install requirements, then generate a P-256 VAPID pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# npm start runs the background worker automatically.
# Set false only if running a dedicated python -m backend.worker process.
EMBEDDED_WORKER=true
